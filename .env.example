# ==============================================================================
# SENIOR WELLNESS CARE - ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env.local in your project root:
#   cp .env.example .env.local
#
# Configuration selected:
# 1. Email: Standard SMTP (Gmail, SendGrid, Amazon SES, or custom SMTP server)
# 2. Google Sheets: Google Cloud Service Account (Google Sheets API v4)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL SENDER & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Sender display name and email address (From header)
EMAIL_FROM="Senior Wellness Care <info@seniorwellnesscare.com>"

# SMTP Server Host (e.g. smtp.gmail.com, smtp.sendgrid.net, mail.yourdomain.com)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Account Username / Email
SMTP_USER=your-email@gmail.com

# SMTP Password or App Password (For Gmail: 16-character App Password)
SMTP_PASSWORD=your-16-char-app-password

# Set to true if using SSL (Port 465), or false if using STARTTLS (Port 587)
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 2. RECIPIENT EMAIL ADDRESSES (Where incoming leads will be sent)
# ------------------------------------------------------------------------------
# Universal Recipient: If set, ALL form submissions will be sent to this email
EMAIL_TO=your-lead-inbox@yourdomain.com

# (Optional) Category-Specific Recipients (Overrides EMAIL_TO if specified):
# EMAIL_TO_GENETIC_TESTING=Genetictesting@seniorwellnesscare.com
# EMAIL_TO_DME=dme@seniorwellnesscare.com
# EMAIL_TO_MEDICAL_ALERT=Medicalalert@seniorwellnesscare.com
# EMAIL_TO_CONTACT=Contact@seniorwellnesscare.com

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS CONFIGURATION (Google Cloud Service Account API v4)
# ------------------------------------------------------------------------------
# From your downloaded Google Cloud Service Account JSON Key file:

# Service account client email (client_email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-collector@your-gcp-project.iam.gserviceaccount.com

# Service account private key (private_key). Ensure line breaks or \n are preserved.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. GOOGLE SPREADSHEET TARGETS
# ------------------------------------------------------------------------------
# Extracted from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit

# Genetic Testing Sheet ID and Tab Name
GOOGLE_SHEET_ID_GENETIC_TESTING=your_genetic_testing_spreadsheet_id_here
GOOGLE_SHEET_TAB_GENETIC_TESTING=Genetic Testing

# DME (Durable Medical Equipment) Sheet ID and Tab Name
GOOGLE_SHEET_ID_DME=your_dme_spreadsheet_id_here
GOOGLE_SHEET_TAB_DME=DME

# Medical Alert Sheet ID and Tab Name
GOOGLE_SHEET_ID_MEDICAL_ALERT=your_medical_alert_spreadsheet_id_here
GOOGLE_SHEET_TAB_MEDICAL_ALERT=Medical Alert
