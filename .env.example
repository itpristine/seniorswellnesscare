# ==============================================================================
# SENIOR WELLNESS CARE — EMAIL & GOOGLE SHEETS INTEGRATION CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OUTGOING EMAIL CONFIGURATION (SMTP / Nodemailer)
# All emails are sent from: info@seniorwellnesscare.com
# ------------------------------------------------------------------------------
EMAIL_FROM="Senior Wellness Care <info@seniorwellnesscare.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="info@seniorwellnesscare.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_SECURE=false

# Optional alternative: Resend API Key (if using Resend instead of SMTP)
# RESEND_API_KEY="re_123456789"

# ------------------------------------------------------------------------------
# 2. GOOGLE SHEETS INTEGRATION CONFIGURATION
# Choose Option A (Webhooks - Fastest & Easiest) or Option B (Google Service Account)
# ------------------------------------------------------------------------------

# Option A: Google Apps Script Webhooks (Recommended & Easiest)
# Deploy google-apps-script-template.js on each sheet and paste URLs below:
GOOGLE_SHEET_WEBHOOK_GENETIC_TESTING="https://script.google.com/macros/s/YOUR_GENETIC_TESTING_DEPLOYMENT_ID/exec"
GOOGLE_SHEET_WEBHOOK_DME="https://script.google.com/macros/s/YOUR_DME_DEPLOYMENT_ID/exec"
GOOGLE_SHEET_WEBHOOK_MEDICAL_ALERT="https://script.google.com/macros/s/YOUR_MEDICAL_ALERT_DEPLOYMENT_ID/exec"

# Option B: Google Cloud Service Account & Sheets API v4
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID_GENETIC_TESTING="your-genetic-testing-sheet-id"
# GOOGLE_SHEET_ID_DME="your-dme-sheet-id"
# GOOGLE_SHEET_ID_MEDICAL_ALERT="your-medical-alert-sheet-id"
